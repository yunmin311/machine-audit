{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/machine-audit/schema/baseline.schema.json",
  "title": "machine-audit baseline",
  "description": "整机基线。第一轮 Bootstrap 建立，后续每轮按同结构重采；stage-02/13 的 diff 只认这份文件。六个固定节（environment / drives / top_dirs / persona / domains / restrictions）就是 stage-00 的输出 schema——改这里必须升技能版本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "environment",
    "drives",
    "top_dirs",
    "persona",
    "domains",
    "restrictions"
  ],
  "properties": {
    "schema_version": {
      "description": "基线结构版本，当前 1.1（形如 1.x）。结构不兼容变更时递增主版本，并升技能版本。",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "meta": {
      "description": "本轮运行的元信息。趋势类结论必须能追到这两轮各自的时间和覆盖状态。",
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "generated_at", "skill_version", "mode"],
      "properties": {
        "run_id": {
          "description": "毫秒级运行 ID，与报告/登记表文件名同源。",
          "type": "string",
          "pattern": "^[0-9]{8}-[0-9]{6}[0-9]{3}$"
        },
        "generated_at": {
          "description": "采集时刻，带时区偏移。禁止只写日期——同一天两次采集必须能区分先后。",
          "type": "string",
          "format": "date-time"
        },
        "skill_version": { "type": "string" },
        "mode": { "enum": ["bootstrap", "quick", "full", "maintain"] },
        "scan_status": {
          "description": "全基线采集状态（选填，默认 ok）；failed 的基线整份不判 PASS；partial 时 top_dirs 须至少一项 sampled=true。",
          "enum": ["ok", "partial", "failed"]
        },
        "previous_run_id": {
          "description": "上一轮 run_id；首跑为 null。",
          "type": ["string", "null"]
        },
        "scope_note": {
          "description": "本轮覆盖范围声明（如'仅系统盘 + 两个数据盘，网络盘未在线'）。",
          "type": "string"
        }
      }
    },
    "environment": {
      "description": "§Environment · 操作系统、权限档位、云重定向、杀软。",
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "user", "privilege", "antivirus"],
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "build", "locale"],
          "properties": {
            "caption": { "type": "string" },
            "build": { "type": "string" },
            "locale": { "type": "string" },
            "edition_note": {
              "description": "版本差异导致的能力缺失（如 Home 无 BitLocker / Get-VM）。",
              "type": "string"
            }
          }
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "profile_path": { "type": "string" }
          }
        },
        "privilege": {
          "description": "权限档位。受限直接影响所有枚举结论的可信度；admin=false 时 restrictions 必须非空或 meta.scope_note 已声明。",
          "type": "object",
          "additionalProperties": false,
          "required": ["admin", "language_mode"],
          "properties": {
            "admin": { "type": "boolean" },
            "language_mode": { "enum": ["FullLanguage", "ConstrainedLanguage", "RestrictedLanguage", "Unknown"] },
            "ps_version": { "type": "string" }
          }
        },
        "antivirus": {
          "description": "命中的杀软/EDR 进程名。非空则报告头必须声明'枚举结果可能不完整'。",
          "type": "array",
          "items": { "type": "string" }
        },
        "cloud_redirection": {
          "description": "User Shell Folders 的真实路径。KFM 未重定向时可能存在两个 Desktop。",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kfm_active": { "type": "boolean" },
            "desktop": { "type": "string" },
            "personal": { "type": "string" },
            "pictures": { "type": "string" }
          }
        }
      }
    },
    "drives": {
      "description": "§Drives · 卷级账目。free_pct 是红线判定的唯一依据，必须实算而非估算。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "size_bytes", "free_bytes", "free_pct", "online"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z]:$" },
          "label": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "free_bytes": { "type": "integer", "minimum": 0 },
          "free_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "online": { "type": "boolean" },
          "media_type": { "enum": ["SSD", "HDD", "SMR", "USB", "Network", "Unknown"] },
          "bus": { "type": "string" },
          "redline": { "enum": ["ok", "warn", "critical"] },
          "note": { "type": "string" }
        }
      }
    },
    "top_dirs": {
      "description": "§TopDirs · 各根目录的一级/二级体量采样。sampled=true 表示未全量枚举——此时不得把数字当精确账目。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "files", "sampled", "owner_note"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "files": { "type": "integer", "minimum": 0 },
          "sampled": { "type": "boolean" },
          "scan_status": {
            "description": "目录采集状态（选填，默认 ok）；failed 时整份基线不判 PASS；partial 时必须 sampled=true。",
            "enum": ["ok", "partial", "failed"]
          },
          "depth": { "type": "integer", "minimum": 1 },
          "last_write": { "type": "string", "format": "date-time" },
          "owner_note": {
            "description": "归属定性（必填）：哪个软件/哪类数据。未知写'待用户定性'，不许留空。",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persona": {
      "description": "§Persona · 角色原语（可叠加），不贴人群标签。决定各子系统权重。",
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "production-code", "production-doc", "production-media", "production-ml",
              "production-design", "production-notes",
              "consume-game", "consume-stream", "consume-read", "consume-download",
              "host-db", "host-service", "host-sync-hub", "host-remote-access",
              "connect-multidevice", "connect-vpn", "connect-lan-share", "connect-remote-work",
              "govern-personal", "govern-family", "govern-org", "govern-pending-verify", "govern-pending-migrate"
            ]
          }
        },
        "evidence": {
          "description": "判定依据（命中的信号），缺失信号不排除角色。",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "domains": {
      "description": "§Domains · 命中的领域包与自建线索。空数组是合法值（通用流程照跑）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["packs"],
      "properties": {
        "packs": { "type": "array", "items": { "type": "string" } },
        "custom": {
          "description": "本机特有领域线索（运行时探索得出，非包内硬编码）。",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal", "meaning"],
            "properties": {
              "signal": { "type": "string" },
              "meaning": { "type": "string" },
              "source": { "type": "string" },
              "as_of": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "restrictions": {
      "description": "§Restrictions · 受限清单。有受限项就没资格说'一切正常'，只能逐项标注覆盖状态。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "scope", "note"],
        "properties": {
          "kind": {
            "enum": ["permission", "policy", "antivirus", "offline", "clm", "long-path", "encoding", "unknown"]
          },
          "scope": { "type": "string" },
          "note": { "type": "string" },
          "affects": {
            "description": "受影响阶段号，如 [\"02\",\"15\"]。",
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9]{2}$" }
          }
        }
      }
    },
    "snapshots": {
      "description": "工具快照（可选）。给脚本消费的结构化结果，不参与六节对位比较。",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "doctor": {
          "description": "project-doctor 的产出快照，供下一轮 -Baseline 做趋势比较。",
          "type": "object",
          "additionalProperties": true,
          "required": ["run_id", "repos"],
          "properties": {
            "run_id": { "type": "string" },
            "repos": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grade", "score"],
                "properties": {
                  "grade": { "type": "string" },
                  "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "backup_gap": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
